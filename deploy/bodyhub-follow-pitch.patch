+static bool HoldingFollowPitch() {
+  return currentControlId == kFollowOwnerId && followWalkPitchDeg != 0.0;
+}
+
+static bool ReadFollowHeadAngles(std::vector<double> &angles) {
+  if (SimControll::simEnable || pthread_mutex_trylock(&mtxOpDxl) != 0)
+    return false;
+  const char *log = NULL;
+  int32_t position[2] = {0, 0};
+  const uint8_t yawId = HEAD_SERVO_ID + 1;
+  const uint8_t pitchId = HEAD_SERVO_ID + 2;
+  const bool read = dxl_wb.readRegister(yawId, "Present_Position", &position[0], &log) &&
+                    dxl_wb.readRegister(pitchId, "Present_Position", &position[1], &log);
+  pthread_mutex_unlock(&mtxOpDxl);
+  if (!read)
+    return false;
+  angles = {convertValueTOAngle(yawId, position[0] - servoOffset[yawId - 1]),
+            convertValueTOAngle(pitchId, position[1] - servoOffset[pitchId - 1])};
+  return std::isfinite(angles[0]) && std::isfinite(angles[1]);
+}
+
+static bool FollowHeadFeedback(bodyhub::SrvServoAllRead::Request &req,
+                               bodyhub::SrvServoAllRead::Response &res) {
+  std::unique_lock<std::mutex> lock(mtxFSM, std::try_to_lock);
+  if (!lock.owns_lock() || !HoldingFollowPitch() || req.idCnt != 2 ||
+      req.idArray.size() != 2 || req.idArray[0] != HEAD_SERVO_ID + 1 ||
+      req.idArray[1] != HEAD_SERVO_ID + 2)
+    return false;
+  if (bodyhubState != StateEnum::ready && bodyhubState != StateEnum::pause &&
+      bodyhubState != StateEnum::running && bodyhubState != StateEnum::walking)
+    return false;
+  return ReadFollowHeadAngles(res.getData);
+}
+
+static bool PrepareFollowWalkingPose() {
+  if (!HoldingFollowPitch())
+    return true;
+  std::vector<double> measured;
+  if (!std::isfinite(followWalkPitchDeg) || followWalkPitchDeg < 0.0 ||
+      followWalkPitchDeg > 20.0 || armMode != 1 || !ReadFollowHeadAngles(measured) ||
+      std::abs(measured[0]) > kFollowHeadTolerance ||
+      std::abs(measured[1] - followWalkPitchDeg) > kFollowHeadTolerance) {
+    ROS_WARN("Follower head pose could not be verified before walking");
+    return false;
+  }
+  pthread_mutex_lock(&mtxMo);
+  ClearQueue(headCtrlQueue);
+  pthread_mutex_unlock(&mtxMo);
+  standPos[HEAD_SERVO_ID] = 0.0;
+  standPos[HEAD_SERVO_ID + 1] = followWalkPitchDeg;
+  return true;
+}
